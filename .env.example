# Copy to .env and adjust. Read by src/mtender/config.py.

# MongoDB connection used by every stage of the pipeline.
#
# The local server runs as a single-node replica set (set name "rs0"), which is
# what enables multi-document transactions. Naming the set in the URI makes the
# driver discover the topology instead of treating the host as a standalone.
# A standalone mongod also connects fine, but sessions and transactions fail.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB_NAME=mtender

# Politeness knobs for the MTender public API.
# Measured latency is ~40 ms per record and no rate limiting was observed at 15
# concurrent requests; 6 is deliberately conservative.
MTENDER_CONCURRENCY=6
MTENDER_PAUSE=0
