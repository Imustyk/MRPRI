.DS_Store
.venv/
.env
.mongo/
node_modules/
__pycache__/
*.pyc
.ruff_cache/

# analyst workspace: local SQLite written by the dashboard and the API
data/workspace/

# --- generated / heavy artifacts (ignored so source-only commits stay small) ---
# `data/*` (not `data/`) so the empty registry TEMPLATE below can be
# re-included; a trailing-slash pattern excludes the directory itself and
# git then never descends into it to honour negations.
data/*
# ...except the case-registry TEMPLATE (empty CSV, schema-only, MTA-0016):
!data/external/
data/external/*
!data/external/case_registry.csv
# the previous blanket `data/` also caught nested data/ dirs (e.g. the
# frontend source folder) - keep them ignored explicitly:
frontend/src/data/
results/
.pytest_cache/
frontend/dist/
frontend/node_modules/
*.egg-info/
